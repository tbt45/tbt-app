<section>
  <dl class="grid gap-8 sm:grid-cols-2">
    <div>
      <dt class="text-sm text-gray-500"><%= t(".latest_weight") %></dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900 tracking-tight">
        <% if @latest_weight %>
          <%= t("goals.show.weight_kg", weight: @latest_weight.weight) %>
        <% else %>
          <%= t("common.not_set") %>
        <% end %>
      </dd>
      <% if @weight_gap %>
        <dd class="mt-1 text-sm <%= @weight_gap.positive? ? 'text-red-600' : 'text-green-600' %>">
          <%= t("goals.show.weight_gap", gap: @weight_gap.abs, direction: @weight_gap.positive? ? t("goals.show.over") : t("goals.show.under")) %>
        </dd>
      <% end %>
    </div>

    <div>
      <dt class="text-sm text-gray-500"><%= t(".intake") %></dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900 tracking-tight">
        <% if @calorie_target %>
          <%= t(".intake_with_target", intake: @intake, target: @calorie_target) %>
        <% else %>
          <%= t("goals.show.calories_kcal", calories: @intake) %>
        <% end %>
      </dd>
      <% unless @calorie_gap.nil? %>
        <dd class="mt-1 text-sm <%= @calorie_gap.positive? ? 'text-red-600' : 'text-green-600' %>">
          <%= t("meal_entries.summary.calorie_gap", gap: @calorie_gap.abs, direction: @calorie_gap.positive? ? t("meal_entries.summary.over") : t("meal_entries.summary.under")) %>
        </dd>
      <% end %>
    </div>

    <div>
      <dt class="text-sm text-gray-500"><%= t(".burned") %></dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900 tracking-tight">
        <%= t("goals.show.calories_kcal", calories: @burned) %>
      </dd>
    </div>

    <div>
      <dt class="text-sm text-gray-500"><%= t(".balance") %></dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900 tracking-tight">
        <%= t("goals.show.calories_kcal", calories: @balance) %>
      </dd>
    </div>
  </dl>
</section>
