<%= turbo_frame_tag "dashboard", class: "block mx-auto w-full max-w-3xl space-y-10" do %>
  <div>
    <h1 class="font-bold text-3xl text-gray-900"><%= t(".title") %></h1>
    <p class="text-gray-500 mt-1"><%= l(@date) %></p>
  </div>

  <%= render "summary" %>
  <%= render "calendar" %>
  <%= render "weight_chart" %>
  <%= render "calorie_chart" %>
<% end %>
